<odoo>
    <record model="ir.ui.view" id="voip_pbx_form_view">
        <field name="model">voip.pbx</field>
        <field name="inherit_id" ref="voip_oca.voip_pbx_form_view" />
        <field name="arch" type="xml">
            <field name="mode" position="after">
                <field name="call_record_mode" />
                <field name="call_recording_sample_rate" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="voip_pbx_list_view">
        <field name="model">voip.pbx</field>
        <field name="inherit_id" ref="voip_oca.voip_pbx_list_view" />
        <field name="arch" type="xml">
            <field name="mode" position="after">
                <field name="call_record_mode" optional="hide" />
                <field name="call_recording_sample_rate" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
