<odoo>
    <record model="ir.ui.view" id="view_users_form">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="voip_oca.view_users_form" />
        <field name="arch" type="xml">
            <field name="voip_password" position="after">
                <field name="call_record_mode" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_users_form_simple_modif">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="voip_oca.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <field name="voip_password" position="after">
                <field name="call_record_mode" />
            </field>
        </field>
    </record>
</odoo>
